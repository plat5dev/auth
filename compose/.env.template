# Image pin for ghcr.io/plat5dev/auth — tags cut from this repo (git tag v*).
AUTH_VERSION=v0.1.8

POSTGRES_USER=auth
POSTGRES_PASSWORD=
POSTGRES_DB=auth

# Public issuer URL. Pins JWT iss + OIDC discovery for OpenAuth-issued tokens
# (not only POST /dev/token). Must match relying-party AUTH_ISSUER.
# Required when the issuer sits behind a proxy that does not forward X-Forwarded-*.
# PUBLIC_ISSUER_URL=https://auth.example.com

# OAuth clients (match relying-party audiences, e.g. plat5 for Plat5)
# AUTH_ALLOWED_CLIENTS=plat5
#
# Required in prod compose. Prod interpolates unset to empty string; the issuer
# treats that as an empty allowlist and denies all /authorize requests.
# Dev compose omits the var so code defaults apply (postman + localhost).
# AUTH_ALLOWED_REDIRECT_URIS=https://app.example.com/callback
# AUTH_ALLOWED_ORIGINS=

# Password-challenge email name (also login title if AUTH_THEME_FILE omits title).
# AUTH_DISPLAY_NAME=Plat5
# Optional OpenAuth Theme JSON (bind-mount the file). Omit = bundled light theme.
# AUTH_THEME_FILE=/config/theme.json

# SMTP — required for prod compose (password challenge email).
# Dev compose omits SMTP; codes are logged by the issuer.
# Point at host-published mail (localhost:587) or a provider.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=mailer@plat5.test
# SMTP_PASS=
# SMTP_FROM=mailer@plat5.test
# SMTP_TLS_INSECURE=true

# Optional OTLP (omit = no export). Containers → host Alloy need host.docker.internal.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
